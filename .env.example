# No es leído automáticamente. Define estas variables en Windows antes de ejecutar.
# El perfil local Ollama no necesita clave:
#   $env:JARVIS_BASE_URL = "http://localhost:11434/v1"
#   $env:JARVIS_MODEL = "qwen2.5:7b"
# Para una API compatible con OpenAI, define además:
#   $env:JARVIS_API_KEY = "tu-clave"
# Reconocimiento de voz local con Vosk (requiere paquete y modelo ya instalado):
#   $env:JARVIS_STT = "vosk"
#   $env:VOSK_MODEL_PATH = "C:\\ruta\\al\\modelo-vosk-es"
